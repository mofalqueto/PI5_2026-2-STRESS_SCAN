[Unit]
Description=Stress Scan API
After=network-online.target
Wants=network-online.target

[Service]
User=nathan
WorkingDirectory=/home/nathan/PI5_2026-2-STRESS_SCAN/api
ExecStart=/home/nathan/PI5_2026-2-STRESS_SCAN/api/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
